# First declare ARG for N8N_VERSION to use in FROM
ARG N8N_VERSION=latest
ARG NODE_VERSION=20

# Start with Node.js Debian slim image as the base (already has Node.js and Python installed)
FROM node:${NODE_VERSION}-bookworm-slim

# Redeclare ARG after FROM
ARG N8N_VERSION
ARG DEBIAN_FRONTEND=noninteractive
ARG DEBIAN_MIRROR=deb.debian.org
ARG SKIP_NONESSENTIAL_PACKAGES=true
ARG N8N_RELEASE_TYPE=stable

# Set environment variables - consolidated to reduce layers
ENV NODE_ENV=production \
	N8N_VERSION=$N8N_VERSION \
	N8N_ENVIRONMENT=production \
	N8N_RELEASE_TYPE=$N8N_RELEASE_TYPE \
	N8N_PATH=/ \
	GENERIC_TIMEZONE=Europe/London \
	TZ=Europe/London \
	DEBIAN_FRONTEND=noninteractive \
	PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
	PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium \
	CHROME_BIN=/usr/bin/chromium \
	CHROME_PATH=/usr/lib/chromium/

# Speed up apt by using a faster mirror if specified
RUN if [ "$DEBIAN_MIRROR" != "deb.debian.org" ]; then \
	sed -i "s/deb.debian.org/$DEBIAN_MIRROR/g" /etc/apt/sources.list.d/*.list /etc/apt/sources.list; \
	fi

# Install required packages (Node.js and npm already included in base image)
RUN apt-get update && apt-get install --no-install-recommends -y \
	ffmpeg \
	tini \
	curl \
	chromium \
	&& mkdir -p /home/node/.n8n \
	&& if [ "$SKIP_NONESSENTIAL_PACKAGES" = "false" ]; then \
	apt-get install --no-install-recommends -y \
	iputils-ping \
	nano \
	libgtk2.0-0 \
	libgtk-3-0 \
	libgbm-dev \
	libnotify-dev \
	libgconf-2-4 \
	libnss3 \
	libxss1 \
	libasound2 \
	libxtst6 \
	xauth \
	xvfb \
	graphicsmagick; \
	fi \
	&& apt-get clean autoclean \
	&& apt-get autoremove --yes \
	&& rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* /var/cache/apt/archives/*.deb

# Set working directory
WORKDIR /home/node

# Install n8n via npm with maximum optimization to prevent timeouts
RUN npm config set update-notifier false && \
	npm config set legacy-peer-deps true && \
	npm config set fetch-retries 5 && \
	npm config set fetch-retry-mintimeout 20000 && \
	npm config set fetch-retry-maxtimeout 120000 && \
	npm config set loglevel error && \
	npm config set fetch-timeout 600000 && \
	if [ "$N8N_VERSION" = "latest" ]; then \
	npm install -g n8n --omit=dev --no-fund --no-audit --no-optional --prefer-offline; \
	else \
	npm install -g n8n@${N8N_VERSION} --omit=dev --no-fund --no-audit --no-optional --prefer-offline; \
	fi && \
	cd /usr/local/lib/node_modules/n8n && npm rebuild sqlite3 && cd - && \
	npm cache clean --force && \
	echo "Installed n8n version: $(n8n --version) with Node.js $(node --version)"

# Copy your custom entrypoint script (if needed)
COPY docker-entrypoint-debian2.sh /

# Set correct permissions
RUN chmod +x /docker-entrypoint-debian2.sh && \
	# Set up required directories
	mkdir -p /home/node/.n8n/storage && \
	chmod 700 /home/node/.n8n/storage && \
	chown -R node:node /home/node

# Set environment variables for Node.js
ENV NODE_PATH=/usr/local/lib/node_modules:/usr/local/lib/node_modules/n8n/node_modules

# Verify n8n and package availability
RUN node -e "require('n8n-core'); require('n8n-nodes-base'); console.log('n8n modules loaded successfully');" || echo "Module check failed but continuing" && \
	[ -f "$PUPPETEER_EXECUTABLE_PATH" ] && echo "Chromium successfully installed" || echo "Warning: Chromium not found at expected path"

# Expose n8n port
EXPOSE 5678

# Add health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
	CMD curl -f http://localhost:5678/healthz || exit 1

# Switch to non-root user
USER node

ENTRYPOINT ["tini", "--", "/docker-entrypoint-debian2.sh"]
CMD ["n8n", "start"]
