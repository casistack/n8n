ARG NODE_VERSION=24.15.0

FROM node:${NODE_VERSION}-bookworm-slim AS builder

ARG DEBIAN_FRONTEND=noninteractive
ARG DEBIAN_MIRROR=ftp.uk.debian.org

ENV CI=true \
	COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
	DEBIAN_FRONTEND=noninteractive

WORKDIR /build

RUN if [ "$DEBIAN_MIRROR" != "deb.debian.org" ]; then \
	sed -i "s/deb.debian.org/$DEBIAN_MIRROR/g" /etc/apt/sources.list.d/*.list /etc/apt/sources.list 2>/dev/null || true; \
	fi

RUN apt-get update && apt-get install -o APT::Status-Fd=1 -o APT::Install-Recommends=0 -y \
	git \
	python3 \
	build-essential \
	ca-certificates \
	&& rm -rf /var/lib/apt/lists/*

COPY . .

RUN corepack enable && \
	pnpm --version && \
	node scripts/build-n8n.mjs

FROM node:${NODE_VERSION}-bookworm-slim

ARG DEBIAN_FRONTEND=noninteractive
ARG DEBIAN_MIRROR=ftp.uk.debian.org
ARG SKIP_NONESSENTIAL_PACKAGES=true
ARG N8N_RELEASE_TYPE=stable

ENV NODE_ENV=production \
	N8N_ENVIRONMENT=production \
	N8N_RELEASE_TYPE=$N8N_RELEASE_TYPE \
	N8N_PATH=/ \
	GENERIC_TIMEZONE=Europe/London \
	TZ=Europe/London \
	DEBIAN_FRONTEND=noninteractive \
	PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
	PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium \
	CHROME_BIN=/usr/bin/chromium \
	CHROME_PATH=/usr/lib/chromium/ \
	NODE_PATH=/usr/local/lib/node_modules:/usr/local/lib/node_modules/n8n/node_modules

RUN if [ "$DEBIAN_MIRROR" != "deb.debian.org" ]; then \
	sed -i "s/deb.debian.org/$DEBIAN_MIRROR/g" /etc/apt/sources.list.d/*.list /etc/apt/sources.list 2>/dev/null || true; \
	fi

RUN apt-get update && apt-get install -o APT::Status-Fd=1 -o APT::Install-Recommends=0 -y \
	tini \
	git \
	curl \
	gosu \
	python3 \
	build-essential \
	ca-certificates \
	&& rm -rf /var/lib/apt/lists/*

RUN for i in 1 2 3; do \
	apt-get update && apt-get install -o APT::Status-Fd=1 -o APT::Install-Recommends=0 -o Dpkg::Options::="--force-confold" -y \
	chromium \
	libgtk-3-0 \
	libgbm-dev \
	libnss3 \
	libxss1 \
	xvfb \
	&& break || { echo "Attempt $i failed, retrying in 5s..."; sleep 5; }; done \
	&& rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get install -o APT::Status-Fd=1 -o APT::Install-Recommends=0 -y \
	ffmpeg \
	&& mkdir -p /home/node/.n8n \
	&& if [ "$SKIP_NONESSENTIAL_PACKAGES" = "false" ]; then \
	apt-get install -o APT::Status-Fd=1 -o APT::Install-Recommends=0 -y \
	iputils-ping \
	nano \
	libgtk2.0-0 \
	libnotify-dev \
	libgconf-2-4 \
	libasound2 \
	libxtst6 \
	xauth \
	graphicsmagick; \
	fi \
	&& apt-get clean autoclean \
	&& apt-get autoremove --yes \
	&& rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* /var/cache/apt/archives/*.deb

WORKDIR /home/node

COPY --from=builder /build/compiled /usr/local/lib/node_modules/n8n
COPY docker-entrypoint-debian2.sh /

RUN chmod +x /docker-entrypoint-debian2.sh && \
	ln -sf /usr/local/lib/node_modules/n8n/bin/n8n /usr/local/bin/n8n && \
	cd /usr/local/lib/node_modules/n8n && \
	npm rebuild sqlite3 && \
	mkdir -p /home/node/.n8n/storage && \
	mkdir -p /home/node/.n8n/nodes && \
	chmod 700 /home/node/.n8n/storage && \
	chmod 755 /home/node/.n8n/nodes && \
	chown -R node:node /home/node && \
	ln -sf /usr/local/bin/npx /usr/bin/npx && \
	npm cache clean --force

RUN node -e "require('n8n-core'); require('n8n-nodes-base'); console.log('n8n modules loaded successfully');" && \
	[ -f "$PUPPETEER_EXECUTABLE_PATH" ] && echo "Chromium successfully installed" && \
	N8N_ENCRYPTION_KEY=build-smoke-test n8n --help > /tmp/n8n-help.txt && \
	grep -q "start:" /tmp/n8n-help.txt && \
	rm -f /tmp/n8n-help.txt

EXPOSE 5678

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
	CMD curl -f http://localhost:5678/healthz || exit 1

ENTRYPOINT ["tini", "--", "/docker-entrypoint-debian2.sh"]
CMD ["n8n", "start"]
